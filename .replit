modules = ["nodejs-24", "python-base-3.13"]
[deployment]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 4179
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 21377
externalPort = 80

[[ports]]
localPort = 23451
externalPort = 3002

[[ports]]
localPort = 23452
externalPort = 3001

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000
